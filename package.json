{
  "name": "my-plugin",
  "private": true,
  "scripts": {
    "build": "npm run build:admin && npm run build:blocks",
    "build:admin": "wp-build",
    "build:blocks": "wp-scripts build --webpack-src-dir=blocks --output-path=build-blocks --webpack-copy-php",
    "dev": "npm-run-all --parallel dev:admin dev:blocks",
    "dev:admin": "wp-build --watch",
    "dev:blocks": "wp-scripts start --webpack-src-dir=blocks --output-path=build-blocks --webpack-copy-php"
  },
  "wpPlugin": {
    "name": "my_plugin",
    "scriptGlobal": "myPlugin",
    "packageNamespace": "my-plugin",
    "pages": [
      "my-admin-page"
    ]
  },
  "devDependencies": {
    "@wordpress/build": "^0.26.0",
    "@wordpress/scripts": "^37.0.0",
    "npm-run-all": "^4.1.5"
  }
}
